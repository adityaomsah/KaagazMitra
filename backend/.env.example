# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file (it is git-ignored).

# Gemini API key for Google GenAI (leave blank when USE_MOCK=1).
GEMINI_API_KEY=

# Gemini model used for Vision extraction.
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to run fully offline using backend/mock/*.json fixtures (no Gemini).
# Keep USE_MOCK=1 functional without Gemini at all times.
USE_MOCK=1
