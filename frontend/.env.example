# Copy to frontend/.env.development (git-ignored) to change local settings.
# No secrets belong in the frontend env: every VITE_* value is shipped to the browser.

# 1 = frontend mock mode: extract() and check() return data from src/mock
#     without calling the backend. Results show a "Sample data" label.
# 0 = call the FastAPI backend through the /api proxy.
VITE_USE_MOCK=1
